//@version=6
indicator("Custom Indicator", overlay=false, max_lines_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
// SYMBOL FILTERS
// -----------------------------------------------------------------------------
isCrypto = syminfo.type == "crypto"

// Only show Bybit funding/expiry for crypto charts.
allowBybitTimingLines = isCrypto

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
emaGroup = "EMA"
showEma9 = input.bool(true, "Show 9 EMA", group=emaGroup)
showEma20 = input.bool(true, "Show 20 EMA", group=emaGroup)
showEma9Offset = input.bool(false, "Enable 9 EMA offset line", group=emaGroup)
ema9OffsetDistance = input.float(0.0, "9 EMA offset distance (%)", minval=0.0, group=emaGroup)
ema9OffsetSide = input.string("Below", "9 EMA offset side", options=["Above", "Below"], group=emaGroup)
showEma20Offset = input.bool(false, "Enable 20 EMA offset line", group=emaGroup)
ema20OffsetDistance = input.float(0.0, "20 EMA offset distance (%)", minval=0.0, group=emaGroup)
ema20OffsetSide = input.string("Below", "20 EMA offset side", options=["Above", "Below"], group=emaGroup)

vwapGroup = "VWAP"
showVwap = input.bool(true, "Show VWAP", group=vwapGroup)
showVwapOffset = input.bool(false, "Enable VWAP offset line", group=vwapGroup)
vwapOffsetDistance = input.float(0.0, "VWAP offset distance (%)", minval=0.0, group=vwapGroup)
vwapOffsetSide = input.string("Below", "VWAP offset side", options=["Above", "Below"], group=vwapGroup)

volumeGroup = "Volume"
showVolume = input.bool(true, "Show Volume", group=volumeGroup)

timingGroup = "Funding/Expiry Timing"
showFunding = input.bool(true, "Show Future Funding Lines (Crypto Only)", group=timingGroup)
showExpiry = input.bool(true, "Show Next Option Expiry Line (Crypto Only)", group=timingGroup)
numFunding = input.int(3, "Number of Future Funding Intervals", minval=1, maxval=100, group=timingGroup)
fundingColor = input.color(color.blue, "Funding Line Color", group=timingGroup)
expiryColor = input.color(color.black, "Expiry Line Color", group=timingGroup)

sessionGroup = "Trading Session Open/Close Lines"
showSessionOpens = input.bool(true, "Show Opens", group=sessionGroup, inline="sessionVisibility")
showSessionCloses = input.bool(true, "Show Closes", group=sessionGroup, inline="sessionVisibility")
showSydneySession = input.bool(true, "Sydney", group=sessionGroup, inline="sessionCustom1")
showTokyoSession = input.bool(true, "Tokyo", group=sessionGroup, inline="sessionCustom1")
showLondonSession = input.bool(true, "London", group=sessionGroup, inline="sessionCustom2")
showNewYorkSession = input.bool(true, "New York", group=sessionGroup, inline="sessionCustom2")

showAnySession = showSydneySession or showTokyoSession or showLondonSession or showNewYorkSession
showAnySessionVisibility = showSessionOpens or showSessionCloses
showSessionLines = showAnySession and showAnySessionVisibility and timeframe.isintraday and timeframe.in_seconds(timeframe.period) <= 30 * 60

// -----------------------------------------------------------------------------
// EMA / VWAP / VOLUME
// -----------------------------------------------------------------------------
applyPercentOffset(baseLine, distancePercent, offsetSide) =>
    offsetFactor = distancePercent / 100.0
    baseLine * (offsetSide == "Above" ? 1.0 + offsetFactor : 1.0 - offsetFactor)

ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema9Offset = applyPercentOffset(ema9, ema9OffsetDistance, ema9OffsetSide)
ema20Offset = applyPercentOffset(ema20, ema20OffsetDistance, ema20OffsetSide)

vwapAnchorTimeframe = timeframe.isintraday ? "D" : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"
vwapAnchor = timeframe.change(vwapAnchorTimeframe)
vwapValue = ta.vwap(hlc3, vwapAnchor)
vwapOffset = applyPercentOffset(vwapValue, vwapOffsetDistance, vwapOffsetSide)

volumeColor = color.new(color.blue, 20)
ema9Color = color.rgb(57, 255, 20)
ema20Color = color.blue
showVwapOnChart = showVwap and isCrypto
showVwapOffsetOnChart = showVwapOffset and isCrypto
showVolumeInPane = showVolume and isCrypto

plot(showEma9 ? ema9 : na, "9 EMA", color=ema9Color, linewidth=2, format=format.price, force_overlay=true)
plot(showEma20 ? ema20 : na, "20 EMA", color=ema20Color, linewidth=2, format=format.price, force_overlay=true)
plot(showVwapOnChart ? vwapValue : na, "VWAP", color=color.new(color.purple, 0), linewidth=2, format=format.price, force_overlay=true)

// plot() cannot draw dashed series lines, so offset lines use recent dashed line segments.
offsetSegmentLimit = 60
var line[] ema9OffsetLines = array.new_line()
var line[] ema20OffsetLines = array.new_line()
var line[] vwapOffsetLines = array.new_line()

drawDashedOffset(array<line> offsetLines, bool enabled, float value, color lineColor) =>
    if barstate.isnew
        if enabled and not na(value) and not na(value[1])
            offsetLine = line.new(x1=bar_index - 1, y1=value[1], x2=bar_index, y2=value,
                                  xloc=xloc.bar_index, extend=extend.none,
                                  color=lineColor, style=line.style_dashed, width=1,
                                  force_overlay=true)
            array.push(offsetLines, offsetLine)
            if array.size(offsetLines) > offsetSegmentLimit
                line.delete(array.shift(offsetLines))
        else
            if array.size(offsetLines) > 0
                for i = 0 to array.size(offsetLines) - 1
                    line.delete(array.get(offsetLines, i))
                array.clear(offsetLines)

drawDashedOffset(ema9OffsetLines, showEma9Offset, ema9Offset, color.new(ema9Color, 30))
drawDashedOffset(ema20OffsetLines, showEma20Offset, ema20Offset, color.new(ema20Color, 30))
drawDashedOffset(vwapOffsetLines, showVwapOffsetOnChart, vwapOffset, color.new(color.purple, 30))

plot(showVolumeInPane ? volume : na, "Volume", color=volumeColor, style=plot.style_columns, format=format.volume)

// -----------------------------------------------------------------------------
// BYBIT FUNDING SCHEDULE (UTC)
// -----------------------------------------------------------------------------
fundingHours = array.from(0, 8, 16)
utcZone = "GMT"

// Current UTC timestamp
now = timenow

// UTC date components
Y = year(now, utcZone)
M = month(now, utcZone)
D = dayofmonth(now, utcZone)

// Helper to generate timestamp for a given day offset and hour
getTs(dayOffset, hr) =>
    timestamp(utcZone, Y, M, D + dayOffset, hr, 0)

// Build list of future funding timestamps
times = array.new_int()
for hourValue in fundingHours
    ts = getTs(0, hourValue)
    if ts > now
        array.push(times, ts)
// Include next day's funding times
for hourValue in fundingHours
    array.push(times, getTs(1, hourValue))
array.sort(times)

topPrice100 = ta.highest(high, 100)
lowPrice100 = ta.lowest(low, 100)

clearLineArray(array<line> lines) =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)

clearLabelArray(array<label> labels) =>
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

pushBoundedLineAndLabel(array<line> lines, array<label> labels, line newLine, label newLabel, int maxObjects) =>
    array.push(lines, newLine)
    array.push(labels, newLabel)
    if array.size(lines) > maxObjects
        line.delete(array.shift(lines))
    if array.size(labels) > maxObjects
        label.delete(array.shift(labels))

// Draw funding lines on <= 30 min intraday charts (crypto only)
var line[] fundingLines = array.new_line()
var label[] fundingLabels = array.new_label()

if barstate.islast
    clearLineArray(fundingLines)
    clearLabelArray(fundingLabels)

if barstate.islast and allowBybitTimingLines and showFunding and timeframe.isintraday and timeframe.multiplier <= 30
    for i = 0 to numFunding - 1
        if i < array.size(times)
            fTs = array.get(times, i)
            fundingLine = line.new(x1=fTs, y1=lowPrice100, x2=fTs, y2=topPrice100,
                                   xloc=xloc.bar_time, extend=extend.both,
                                   color=fundingColor, style=line.style_dashed,
                                   force_overlay=true)
            fundingLabel = label.new(x=fTs, y=topPrice100, text="Funding",
                                     xloc=xloc.bar_time, yloc=yloc.price,
                                     color=color.new(fundingColor, 0), textcolor=color.white,
                                     style=label.style_label_down, size=size.small,
                                     force_overlay=true)
            pushBoundedLineAndLabel(fundingLines, fundingLabels, fundingLine, fundingLabel, numFunding)

// Compute next option expiry at 08:00 UTC (Brisbane 18:00)
expTs = timestamp(utcZone, Y, M, D, 8, 0)
if expTs <= now
    expTs := timestamp(utcZone, Y, M, D + 1, 8, 0)

// Draw single expiry line on <= 4 h intraday charts (crypto only)
var line expiryLine = na
var label expiryLabel = na

if barstate.islast
    if not na(expiryLine)
        line.delete(expiryLine)
        expiryLine := na
    if not na(expiryLabel)
        label.delete(expiryLabel)
        expiryLabel := na

if barstate.islast and allowBybitTimingLines and showExpiry and timeframe.isintraday and timeframe.multiplier <= 240
    expiryLine := line.new(x1=expTs, y1=lowPrice100, x2=expTs, y2=topPrice100,
                           xloc=xloc.bar_time, extend=extend.both,
                           color=expiryColor, style=line.style_dashed, width=2,
                           force_overlay=true)
    expiryLabel := label.new(x=expTs, y=topPrice100, text="OP EX",
                             xloc=xloc.bar_time, yloc=yloc.price,
                             color=color.new(expiryColor, 0), textcolor=color.white,
                             style=label.style_label_down, size=size.small,
                             force_overlay=true)

// -----------------------------------------------------------------------------
// TRADING SESSION OPEN/CLOSE LINES
// -----------------------------------------------------------------------------
var line[] sessionMarkerLines = array.new_line()
var label[] sessionLabels = array.new_label()
sessionMaxMarkers = 192
sessionMarkerLineNearMultiplier = 0.35
sessionMarkerLineFarMultiplier = 2.4
sessionLabelOffsetMultiplier = 2.65

sessionEventTimestamp(simple string sessionTimezone, simple int eventHour, simple int eventMinute) =>
    timestamp(sessionTimezone, year(time, sessionTimezone), month(time, sessionTimezone), dayofmonth(time, sessionTimezone), eventHour, eventMinute)

isSessionEvent(simple string sessionTimezone, simple int eventHour, simple int eventMinute) =>
    eventTs = sessionEventTimestamp(sessionTimezone, eventHour, eventMinute)
    time <= eventTs and eventTs < time_close

horizontalSessionText(simple string sessionCode, simple bool isOpen) =>
    sessionCode + (isOpen ? " O" : " C")

drawSessionMarker(simple string sessionTimezone, simple int eventHour, simple int eventMinute, simple string sessionCode, simple bool isOpen) =>
    eventTs = sessionEventTimestamp(sessionTimezone, eventHour, eventMinute)
    candleRange = math.max(high - low, syminfo.mintick * 20)
    lineStartY = isOpen ? high + candleRange * sessionMarkerLineNearMultiplier : low - candleRange * sessionMarkerLineNearMultiplier
    lineEndY = isOpen ? high + candleRange * sessionMarkerLineFarMultiplier : low - candleRange * sessionMarkerLineFarMultiplier
    labelY = isOpen ? high + candleRange * sessionLabelOffsetMultiplier : low - candleRange * sessionLabelOffsetMultiplier
    sessionMarkerLine = line.new(x1=eventTs, y1=lineStartY, x2=eventTs, y2=lineEndY,
                                 xloc=xloc.bar_time, extend=extend.none,
                                 color=color.black, style=line.style_dashed, width=2,
                                 force_overlay=true)
    sessionLabel = label.new(x=eventTs, y=labelY, text=horizontalSessionText(sessionCode, isOpen),
                             xloc=xloc.bar_time, yloc=yloc.price,
                             color=color.new(color.white, 100), textcolor=color.black,
                             style=label.style_none, size=size.large, textalign=text.align_center,
                             force_overlay=true)
    pushBoundedLineAndLabel(sessionMarkerLines, sessionLabels, sessionMarkerLine, sessionLabel, sessionMaxMarkers)

if showSessionLines and barstate.isnew
    if showSydneySession
        if showSessionOpens and isSessionEvent("Australia/Sydney", 8, 0)
            drawSessionMarker("Australia/Sydney", 8, 0, "SYD", true)
        if showSessionCloses and isSessionEvent("Australia/Sydney", 17, 0)
            drawSessionMarker("Australia/Sydney", 17, 0, "SYD", false)

    if showTokyoSession
        if showSessionOpens and isSessionEvent("Asia/Tokyo", 9, 0)
            drawSessionMarker("Asia/Tokyo", 9, 0, "TKY", true)
        if showSessionCloses and isSessionEvent("Asia/Tokyo", 18, 0)
            drawSessionMarker("Asia/Tokyo", 18, 0, "TKY", false)

    if showLondonSession
        if showSessionOpens and isSessionEvent("Europe/London", 8, 0)
            drawSessionMarker("Europe/London", 8, 0, "LDN", true)
        if showSessionCloses and isSessionEvent("Europe/London", 17, 0)
            drawSessionMarker("Europe/London", 17, 0, "LDN", false)

    if showNewYorkSession
        if showSessionOpens and isSessionEvent("America/New_York", 8, 0)
            drawSessionMarker("America/New_York", 8, 0, "NY", true)
        if showSessionCloses and isSessionEvent("America/New_York", 17, 0)
            drawSessionMarker("America/New_York", 17, 0, "NY", false)
else if barstate.isnew and not showSessionLines
    clearLineArray(sessionMarkerLines)
    clearLabelArray(sessionLabels)
