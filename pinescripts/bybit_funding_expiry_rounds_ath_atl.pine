//@version=6
indicator("Bybit Funding/Expiry + Round Numbers + ATH/ATL", overlay=true, max_lines_count=500)

// -----------------------------------------------------------------------------
// SYMBOL FILTERS
// -----------------------------------------------------------------------------
isForex = syminfo.type == "forex"

// Only show Bybit funding/expiry for NON-forex charts
allowBybitTimingLines = not isForex

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
showFunding   = input.bool(true,  "Show Future Funding Lines (Non-Forex Only)")
showExpiry    = input.bool(true,  "Show Next Option Expiry Line (Non-Forex Only)")
numFunding    = input.int(3,      "Number of Future Funding Intervals", minval=1)
fundingColor  = input.color(color.blue,  "Funding Line Color")
expiryColor   = input.color(color.black, "Expiry Line Color")

showRounds    = input.bool(true,  "Show Nearby Round Numbers")
roundStep     = input.float(100.0,"Round Number Step (price units)", minval=0.00000001)
roundLevels   = input.int(6,      "How Many Levels Above/Below", minval=1)
roundColor    = input.color(color.gray,  "Round Line Color")

showATHATL    = input.bool(true,  "Show ATH/ATL Lines")
athColor      = input.color(color.green, "ATH Line Color")
atlColor      = input.color(color.red,   "ATL Line Color")

sessionGroup = "Trading Session Open/Close Lines"
sessionMode  = input.string("Off", "Session Lines", options=["Off", "All", "Custom", "Sydney", "Tokyo", "London", "New York"], group=sessionGroup)
customSydney = input.bool(true, "Sydney", group=sessionGroup, inline="sessionCustom1")
customTokyo  = input.bool(true, "Tokyo", group=sessionGroup, inline="sessionCustom1")
customLondon = input.bool(true, "London", group=sessionGroup, inline="sessionCustom2")
customNewYork = input.bool(true, "New York", group=sessionGroup, inline="sessionCustom2")

showSydneySession  = sessionMode == "All" or sessionMode == "Sydney" or (sessionMode == "Custom" and customSydney)
showTokyoSession   = sessionMode == "All" or sessionMode == "Tokyo" or (sessionMode == "Custom" and customTokyo)
showLondonSession  = sessionMode == "All" or sessionMode == "London" or (sessionMode == "Custom" and customLondon)
showNewYorkSession = sessionMode == "All" or sessionMode == "New York" or (sessionMode == "Custom" and customNewYork)
showSessionLines   = sessionMode != "Off" and timeframe.isintraday and timeframe.in_seconds(timeframe.period) <= 60 * 60

// -----------------------------------------------------------------------------
// BYBIT FUNDING SCHEDULE (UTC)
// -----------------------------------------------------------------------------
fundingHours = array.from(0, 8, 16)
utcZone      = "GMT"

// Current UTC timestamp
now = timenow

// UTC date components
Y = year(now, utcZone)
M = month(now, utcZone)
D = dayofmonth(now, utcZone)

// Helper to generate timestamp for a given day offset and hour
getTs(dayOffset, hr) =>
    timestamp(utcZone, Y, M, D + dayOffset, hr, 0)

// Build list of future funding timestamps
times = array.new_int()
for hourValue in fundingHours
    ts = getTs(0, hourValue)
    if ts > now
        array.push(times, ts)
// Include next day's funding times
for hourValue in fundingHours
    array.push(times, getTs(1, hourValue))
array.sort(times)

topPrice100 = ta.highest(high, 100)
lowPrice100 = ta.lowest(low, 100)

// Draw funding lines on <= 30 min intraday charts (NON-FOREX ONLY)
var line[] fundingLines = array.new_line()

if barstate.islast
    if array.size(fundingLines) > 0
        for i = 0 to array.size(fundingLines) - 1
            line.delete(array.get(fundingLines, i))
        array.clear(fundingLines)

if barstate.islast and allowBybitTimingLines and showFunding and timeframe.isintraday and timeframe.multiplier <= 30
    for i = 0 to numFunding - 1
        if i < array.size(times)
            fTs = array.get(times, i)
            fundingLine = line.new(x1 = fTs, y1 = lowPrice100, x2 = fTs, y2 = topPrice100,
                                   xloc = xloc.bar_time, extend = extend.both,
                                   color = fundingColor, style = line.style_dashed)
            array.push(fundingLines, fundingLine)

// Compute next option expiry at 08:00 UTC (Brisbane 18:00)
expTs = timestamp(utcZone, Y, M, D, 8, 0)
if expTs <= now
    expTs := timestamp(utcZone, Y, M, D + 1, 8, 0)

// Draw single expiry line on <= 4 h intraday charts (NON-FOREX ONLY)
var line expiryLine = na

if barstate.islast
    if not na(expiryLine)
        line.delete(expiryLine)
        expiryLine := na

if barstate.islast and allowBybitTimingLines and showExpiry and timeframe.isintraday and timeframe.multiplier <= 240
    expiryLine := line.new(x1 = expTs, y1 = lowPrice100, x2 = expTs, y2 = topPrice100,
                           xloc = xloc.bar_time, extend = extend.both,
                           color = expiryColor, style = line.style_dashed, width = 2)

// -----------------------------------------------------------------------------
// TRADING SESSION OPEN/CLOSE LINES
// -----------------------------------------------------------------------------
var line[] sessionLines = array.new_line()
sessionMaxLines = 192

sydneyColor = color.rgb(0, 137, 123)
tokyoColor = color.rgb(245, 124, 0)
londonColor = color.rgb(63, 81, 181)
newYorkColor = color.rgb(213, 0, 0)

sessionEventTimestamp(simple string sessionTimezone, simple int eventHour, simple int eventMinute) =>
    timestamp(sessionTimezone, year(time, sessionTimezone), month(time, sessionTimezone), dayofmonth(time, sessionTimezone), eventHour, eventMinute)

isSessionEvent(simple string sessionTimezone, simple int eventHour, simple int eventMinute) =>
    eventTs = sessionEventTimestamp(sessionTimezone, eventHour, eventMinute)
    time <= eventTs and eventTs < time_close

drawSessionLine(simple string sessionTimezone, simple int eventHour, simple int eventMinute, color sessionColor, simple bool isOpen) =>
    eventTs = sessionEventTimestamp(sessionTimezone, eventHour, eventMinute)
    lineColor = isOpen ? sessionColor : color.new(sessionColor, 65)
    lineStyle = isOpen ? line.style_solid : line.style_dotted
    sessionLine = line.new(x1 = eventTs, y1 = low, x2 = eventTs, y2 = high,
                           xloc = xloc.bar_time, extend = extend.both,
                           color = lineColor, style = lineStyle, width = 1)
    array.push(sessionLines, sessionLine)
    if array.size(sessionLines) > sessionMaxLines
        line.delete(array.shift(sessionLines))

if showSessionLines and barstate.isnew
    if showSydneySession
        if isSessionEvent("Australia/Sydney", 8, 0)
            drawSessionLine("Australia/Sydney", 8, 0, sydneyColor, true)
        if isSessionEvent("Australia/Sydney", 17, 0)
            drawSessionLine("Australia/Sydney", 17, 0, sydneyColor, false)

    if showTokyoSession
        if isSessionEvent("Asia/Tokyo", 9, 0)
            drawSessionLine("Asia/Tokyo", 9, 0, tokyoColor, true)
        if isSessionEvent("Asia/Tokyo", 18, 0)
            drawSessionLine("Asia/Tokyo", 18, 0, tokyoColor, false)

    if showLondonSession
        if isSessionEvent("Europe/London", 8, 0)
            drawSessionLine("Europe/London", 8, 0, londonColor, true)
        if isSessionEvent("Europe/London", 17, 0)
            drawSessionLine("Europe/London", 17, 0, londonColor, false)

    if showNewYorkSession
        if isSessionEvent("America/New_York", 8, 0)
            drawSessionLine("America/New_York", 8, 0, newYorkColor, true)
        if isSessionEvent("America/New_York", 17, 0)
            drawSessionLine("America/New_York", 17, 0, newYorkColor, false)

// -----------------------------------------------------------------------------
// NEARBY ROUND NUMBERS (HORIZONTAL LINES)
// -----------------------------------------------------------------------------
var line[] roundLines = array.new_line()

if barstate.islast
    // clear old lines
    if array.size(roundLines) > 0
        for i = 0 to array.size(roundLines) - 1
            line.delete(array.get(roundLines, i))
        array.clear(roundLines)

    if showRounds
        step = roundStep
        base = math.round(close / step) * step

        // draw levels around current price
        for k = -roundLevels to roundLevels
            lvl = base + (k * step)
            ln = line.new(
                x1 = bar_index - 1, y1 = lvl,
                x2 = bar_index,     y2 = lvl,
                xloc = xloc.bar_index,
                extend = extend.both,
                color = roundColor,
                style = line.style_solid,
                width = 1
            )
            array.push(roundLines, ln)

// -----------------------------------------------------------------------------
// ALL TIME HIGH / LOW (HORIZONTAL LINES)
// -----------------------------------------------------------------------------
var float ATH = na
var float ATL = na

if na(ATH)
    ATH := high
if na(ATL)
    ATL := low

ATH := math.max(ATH, high)
ATL := math.min(ATL, low)

var line athLine = na
var line atlLine = na

if barstate.islast
    if showATHATL
        if na(athLine)
            athLine := line.new(bar_index - 1, ATH, bar_index, ATH, xloc=xloc.bar_index, extend=extend.both, color=athColor, width=2)
        else
            line.set_y1(athLine, ATH), line.set_y2(athLine, ATH)

        if na(atlLine)
            atlLine := line.new(bar_index - 1, ATL, bar_index, ATL, xloc=xloc.bar_index, extend=extend.both, color=atlColor, width=2)
        else
            line.set_y1(atlLine, ATL), line.set_y2(atlLine, ATL)
    else
        if not na(athLine)
            line.delete(athLine), athLine := na
        if not na(atlLine)
            line.delete(atlLine), atlLine := na
