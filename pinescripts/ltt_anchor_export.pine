//@version=6
indicator("LTT Anchor Export 2A.1 (personal)", overlay = true, behind_chart = false, max_lines_count = 1)
// UPDATE: remove/re-add ONLY this helper instance for behind_chart=false to apply.
// behind_chart=false places it in front of chart bars, not necessarily every
// manual drawing. Use the helper's Visual Order > Bring to front if needed.
// Preserve all rectangles, drawings and Custom Indicator. Copy the NEW ready
// message after every point change; old Pine Logs messages are not current state.
// PERSONAL script: published scripts cannot generate Pine Logs.
// Select two endpoints on the SAME intended channel boundary, first then second.
// Drag the paired markers, edit exact prices in Settings > Inputs, or use the
// script menu's Reset points to reselect. This cannot inspect drawing-tool lines.
// Copy ONE complete LTT_ANCHORS_V1 message from Pine Logs into LTT.
// Contract: schema ltt-anchors/v1; timestamp_ms = exact selected UNIX ms;
// price = positive decimal string; optional right_extension = boolean.
// Explicit future coordinates are valid, not future market observations.
// Changes require a NEW copy/import/Apply/Save; saved LTT plans do not live-sync.
// No alerts, webhooks, strategy or broker IO.
float price1 = input.price(0, "Price 1", inline = "A1", group = "Anchor 1", confirm = true)
int time1 = input.time(0, "Time 1", inline = "A1", group = "Anchor 1", confirm = true)
float price2 = input.price(0, "Price 2", inline = "A2", group = "Anchor 2", confirm = true)
int time2 = input.time(0, "Time 2", inline = "A2", group = "Anchor 2", confirm = true)

bool extendRight = input.bool(true, "Extend right", tooltip = "Draw the same right-extending ray as LTT. Copy/import/Apply/Save again after changes.")

bool supported = chart.is_standard and (timeframe.isseconds or timeframe.isminutes or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)
string reason = ""
if not supported
    reason := "Unsupported chart. Use standard time-based bars/candles."
else if time1 <= 0 or time2 <= 0
    reason := "Select both anchor points (Reset points to reselect)."
else if time2 <= time1
    reason := "Anchor 2 must be later than anchor 1."
else if price1 <= 0 or price2 <= 0
    reason := "Both coordinate prices must be positive."
else if time1 > 8640000000000000 or time2 > 8640000000000000
    reason := "Coordinate time is outside the supported UTC date range."
bool valid = reason == ""
var line boundary = na
var table selectionStatus = table.new(position.top_right, 1, 1, bgcolor = color.black, frame_color = color.white, frame_width = 1)
varip string emitted = ""
string coordinates = "A1 UTC " + str.format_time(time1, "yyyy-MM-dd HH:mm:ss", "UTC") + " @ " + str.tostring(price1, "0.################") + "\nA2 UTC " + str.format_time(time2, "yyyy-MM-dd HH:mm:ss", "UTC") + " @ " + str.tostring(price2, "0.################")
if barstate.islast
    string status = "LTT Anchor Export 2A.1 | " + syminfo.tickerid + " / " + timeframe.period + "\nExtension " + (extendRight ? "ON (right ray)" : "OFF (segment)") + "\n" + (valid ? "READY - copy the NEW LTT_ANCHORS_V1 message.\n" : "NOT READY: " + reason + "\n") + coordinates
    table.cell(selectionStatus, 0, 0, status, text_color = valid ? color.aqua : color.yellow, bgcolor = color.black, text_size = size.small)
    if valid
        if na(boundary)
            boundary := line.new(time1, price1, time2, price2, xloc = xloc.bar_time, extend = extendRight ? extend.right : extend.none, color = color.rgb(0, 255, 255), width = 4)
        else
            line.set_xy1(boundary, time1, price1)
            line.set_xy2(boundary, time2, price2)
            line.set_extend(boundary, extendRight ? extend.right : extend.none)
        string packet = '{"schema":"ltt-anchors/v1","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","right_extension":' + (extendRight ? "true" : "false") + ',"anchors":[{"timestamp_ms":' + str.tostring(time1, "0") + ',"price":"' + str.tostring(price1, "0.################") + '"},{"timestamp_ms":' + str.tostring(time2, "0") + ',"price":"' + str.tostring(price2, "0.################") + '"}]}'
        if packet != emitted
            log.info("LTT Anchor Export 2A.1 | LTT_ANCHORS_V1 " + packet)
            emitted := packet
    else
        if not na(boundary)
            line.delete(boundary)
            boundary := na
        if status != emitted
            log.warning(status)
            emitted := status
