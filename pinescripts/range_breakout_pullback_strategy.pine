//@version=6
strategy("Range Breakout-Pullback Strategy", overlay=true, pyramiding=0, process_orders_on_close=true, max_lines_count=500)

// This strategy converts the conceptual pullback turning point into a confirmed,
// non-lookahead market entry. With process_orders_on_close=true, TradingView's
// broker emulator fills the order on the confirmation bar's close.

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
directionGroup = "1. Trade directions"
enableLongs = input.bool(true, "Enable long trades", group=directionGroup, tooltip="Allows bullish range breakout-pullback trades.")
enableShorts = input.bool(true, "Enable short trades", group=directionGroup, tooltip="Allows the exact inverse bearish setup.")

modeGroup = "2. Setup mode"
setupMode = input.string("Range Breakout-Pullback", "Setup mode", options=["Range Breakout-Pullback", "Impulse Pullback Continuation"], group=modeGroup, tooltip="Range preserves the original strict horizontal-range logic. Impulse uses a standalone ATR-normalized directional displacement followed by a pullback.")

rangeGroup = "3. Original horizontal range detection"
pivotStrength = input.int(3, "Confirmed pivot strength", minval=1, maxval=20, group=rangeGroup, tooltip="A pivot needs this many bars on both sides. It becomes available only after the right-side bars have closed.")
minimumReactions = input.int(2, "Minimum reactions per side", minval=2, maxval=10, group=rangeGroup, tooltip="Required clustered pivot highs at resistance and clustered pivot lows at support.")
clusterToleranceAtr = input.float(0.35, "Clustering tolerance (ATR)", minval=0.05, step=0.05, group=rangeGroup, tooltip="A new confirmed pivot joins the current boundary cluster when it is within this many ATR of the running cluster centre.")
minimumRangeHeightAtr = input.float(2.0, "Minimum range height (ATR)", minval=0.1, step=0.1, group=rangeGroup, tooltip="Support must remain below resistance by at least this many current ATR.")
minimumRangeBars = input.int(10, "Minimum range duration (bars)", minval=1, group=rangeGroup, tooltip="Minimum span from the earliest qualifying reaction to the latest qualifying reaction.")
maximumRangeBars = input.int(250, "Maximum range duration/staleness (bars)", minval=10, group=rangeGroup, tooltip="A boundary cluster is discarded when its most recent reaction is older than this many bars; a combined range cannot span longer than this.")

breakoutGroup = "4. Original range breakout and extension"
breakoutBufferAtr = input.float(0.10, "Breakout close buffer (ATR)", minval=0.0, step=0.05, group=breakoutGroup, tooltip="A completed close must clear the frozen boundary by this ATR fraction.")
minimumBreakoutBodyAtr = input.float(0.25, "Minimum breakout body (ATR)", minval=0.0, step=0.05, group=breakoutGroup, tooltip="Rejects negligible breaches. Set to 0 to disable the candle-body filter.")
minimumExtensionAtr = input.float(0.75, "Minimum post-breakout extension (ATR)", minval=0.05, step=0.05, group=breakoutGroup, tooltip="After the breakout bar, price must extend this far beyond the broken boundary before a pullback can qualify. The positive minimum also keeps pullback-depth division valid.")
maximumExtensionBars = input.int(20, "Maximum extension wait (bars)", minval=1, group=breakoutGroup, tooltip="Expires a breakout if the required post-breakout extension is not confirmed within this many bars.")

impulseGroup = "5. Impulse pullback continuation"
impulseMinimumBodyAtr = input.float(1.0, "Minimum impulse body (ATR)", minval=0.1, step=0.1, group=impulseGroup)
impulseMinimumRangeAtr = input.float(1.25, "Minimum impulse range (ATR)", minval=0.1, step=0.1, group=impulseGroup)
impulseMinimumRetracementAtr = input.float(0.50, "Minimum pullback retracement (ATR)", minval=0.0, step=0.05, group=impulseGroup)
impulseMaximumDepth = input.float(75.0, "Maximum pullback depth (%)", minval=1.0, maxval=500.0, step=0.5, group=impulseGroup)
impulseMaximumPullbackBars = input.int(30, "Maximum pullback duration (bars)", minval=1, group=impulseGroup)

pullbackGroup = "6. Shared corrective pullback"
minimumOpposingCloses = input.int(2, "Minimum opposing closes", minval=1, maxval=20, group=pullbackGroup, tooltip="Longs count lower closes; shorts count higher closes. The count starts after extension is confirmed.")
minimumRetracementAtr = input.float(0.50, "Minimum retracement (ATR)", minval=0.0, step=0.05, group=pullbackGroup, tooltip="Minimum correction from the post-breakout extreme.")
pullbackDepthMode = input.string("Any valid depth", "Pullback Depth Mode", options=["Any valid depth", "Shallow", "Deep", "Custom range"], group=pullbackGroup, tooltip="Any accepts the first otherwise-valid correction. Shallow, Deep and Custom arm only inside their selected extension-relative depth interval and disqualify a setup that exceeds its maximum before entry.")
shallowMinimumDepth = input.float(0.0, "Shallow minimum depth (%)", minval=0.0, maxval=500.0, step=0.5, group=pullbackGroup)
shallowMaximumDepth = input.float(50.0, "Shallow maximum depth (%)", minval=0.0, maxval=500.0, step=0.5, group=pullbackGroup)
deepMinimumDepth = input.float(50.0, "Deep minimum depth (%)", minval=0.0, maxval=500.0, step=0.5, group=pullbackGroup)
deepMaximumDepth = input.float(100.0, "Deep maximum depth (%)", minval=0.0, maxval=500.0, step=0.5, group=pullbackGroup)
customMinimumDepth = input.float(0.0, "Custom minimum depth (%)", minval=0.0, maxval=500.0, step=0.5, group=pullbackGroup)
customMaximumDepth = input.float(100.0, "Custom maximum depth (%)", minval=0.0, maxval=500.0, step=0.5, group=pullbackGroup)
invalidationToleranceAtr = input.float(0.25, "Close-back-inside tolerance (ATR)", minval=0.0, step=0.05, group=pullbackGroup, tooltip="Invalidates a long after a close this far below old resistance, or a short after the inverse close above old support.")
maximumPullbackBars = input.int(30, "Maximum pullback bars", minval=1, group=pullbackGroup, tooltip="Expires the setup this many bars after extension confirmation.")

entryGroup = "7. Shared price-action resumption"
confirmationMode = input.string("Balanced", "Confirmation mode", options=["Aggressive", "Balanced", "Conservative"], group=entryGroup, tooltip="Aggressive: first close resuming in the trade direction. Balanced: directional candle closes beyond the previous bar. Conservative: close beyond the latest confirmed minor pullback swing.")
minorSwingStrength = input.int(2, "Conservative minor-swing strength", minval=1, maxval=10, group=entryGroup, tooltip="Bars on each side needed to confirm the minor swing used only by Conservative mode.")

riskGroup = "8. ATR stop and profit target"
stopMode = input.string("Adaptive ATR", "Stop mode", options=["Adaptive ATR", "Fixed ATR multiple"], group=riskGroup, tooltip="Adaptive ATR selects a transparent multiplier from the current ATR%-percentile regime. Fixed mode always uses one multiplier.")
atrLength = input.int(14, "ATR length", minval=1, group=riskGroup, tooltip="ATR uses TradingView's RMA-based ta.atr calculation.")
fixedAtrMultiplier = input.float(1.5, "Fixed ATR multiplier", minval=0.1, step=0.1, group=riskGroup, tooltip="Used only in Fixed ATR multiple mode; values such as 0.5, 1.0, 1.5 and 2.0 are accepted.")
regimeLookback = input.int(200, "ATR% percentile lookback", minval=20, group=riskGroup, tooltip="Ranks current ATR as a percentage of price against current and earlier observations only.")
lowRegimePercentile = input.float(33.0, "Low-volatility percentile", minval=0.0, maxval=100.0, step=1.0, group=riskGroup)
highRegimePercentile = input.float(67.0, "High-volatility percentile", minval=0.0, maxval=100.0, step=1.0, group=riskGroup)
lowVolatilityMultiplier = input.float(1.0, "Low-volatility ATR multiplier", minval=0.1, step=0.1, group=riskGroup)
normalVolatilityMultiplier = input.float(1.5, "Normal-volatility ATR multiplier", minval=0.1, step=0.1, group=riskGroup)
highVolatilityMultiplier = input.float(2.0, "High-volatility ATR multiplier", minval=0.1, step=0.1, group=riskGroup)
riskRewardMultiple = input.float(2.0, "Profit target (R)", minval=0.1, step=0.1, group=riskGroup, tooltip="Every target is frozen at entry at this multiple of the actual entry-to-stop distance. Default is exactly 2R.")

weekendGroup = "9. FX Weekend blackout"
enableWeekendBlackout = input.bool(true, "Enable FX Weekend rules", group=weekendGroup, tooltip="Uses the repository FX Weekend schedule: flat and no entries from Friday 15:00 until Sunday 17:00 America/New_York, with IANA daylight-saving handling.")
shadeWeekendBlackout = input.bool(true, "Shade blocked periods", group=weekendGroup, tooltip="Adds subtle background shading while new entries are blocked and positions must be flat.")

visualGroup = "10. Visual audit"
showSetupDiagnostics = input.bool(false, "Show setup diagnostics", group=visualGroup, tooltip="Shows structural zones and Data Window values. Bullish gate: 1 disabled, 2 FX blocked, 3 position/order busy, 4 bearish setup active, 5 no range, 6 breakout absent, 7 extension pending, 8 pullback absent, 9 correction insufficient, 10 resumption absent, 11 ATR unready, 12 entry requested, 13 long filled. Reset: 1 invalidated, 2 extension expired, 3 pullback expired, 4 depth exceeded.")
showStopLoss = input.bool(false, "Show active stop-loss", group=visualGroup, tooltip="Shows the frozen stop only while its trade is open. Historical take-profit lines remain visible by default.")

// -----------------------------------------------------------------------------
// VOLATILITY AND TIME HELPERS
// -----------------------------------------------------------------------------
atrValue = ta.atr(atrLength)
atrPercent = na(close) or close == 0.0 ? na : atrValue / close * 100.0

percentRank(float value, int lookback) =>
    float atOrBelow = 0.0
    float observations = 0.0
    for offset = 0 to lookback - 1
        historicalValue = atrPercent[offset]
        if not na(historicalValue) and not na(value)
            observations += 1.0
            atOrBelow += historicalValue <= value ? 1.0 : 0.0
    observations == lookback ? atOrBelow / observations * 100.0 : na

roundDownToTick(float value) =>
    math.floor(value / syminfo.mintick) * syminfo.mintick

roundUpToTick(float value) =>
    math.ceil(value / syminfo.mintick) * syminfo.mintick

atrPercentile = percentRank(atrPercent, regimeLookback)
effectiveLowPercentile = math.min(lowRegimePercentile, highRegimePercentile)
effectiveHighPercentile = math.max(lowRegimePercentile, highRegimePercentile)
adaptiveMultiplier = atrPercentile <= effectiveLowPercentile ? lowVolatilityMultiplier : atrPercentile >= effectiveHighPercentile ? highVolatilityMultiplier : normalVolatilityMultiplier
selectedAtrMultiplier = stopMode == "Adaptive ATR" ? adaptiveMultiplier : fixedAtrMultiplier
riskDataReady = not na(atrValue) and (stopMode == "Fixed ATR multiple" or not na(atrPercentile))

configuredDepthMinimum = pullbackDepthMode == "Shallow" ? shallowMinimumDepth : pullbackDepthMode == "Deep" ? deepMinimumDepth : customMinimumDepth
configuredDepthMaximum = pullbackDepthMode == "Shallow" ? shallowMaximumDepth : pullbackDepthMode == "Deep" ? deepMaximumDepth : customMaximumDepth
selectedDepthMinimum = math.min(configuredDepthMinimum, configuredDepthMaximum)
selectedDepthMaximum = math.max(configuredDepthMinimum, configuredDepthMaximum)
depthHasMaximum = pullbackDepthMode != "Any valid depth"

// FX Weekend's Brisbane DST/standard cutoffs are both Friday 15:00 in New York.
// IANA timezone conversion applies the historical New York DST rules automatically.
fxTimezone = "America/New_York"
fxDay = dayofweek(time_close, fxTimezone)
fxMinutes = hour(time_close, fxTimezone) * 60 + minute(time_close, fxTimezone)
fxBlockedRaw = (fxDay == dayofweek.friday and fxMinutes >= 15 * 60) or fxDay == dayofweek.saturday or (fxDay == dayofweek.sunday and fxMinutes < 17 * 60)
fxBlocked = enableWeekendBlackout and fxBlockedRaw

// -----------------------------------------------------------------------------
// CONFIRMED PIVOT CLUSTERS AND RANGE
// -----------------------------------------------------------------------------
confirmedPivotHigh = ta.pivothigh(high, pivotStrength, pivotStrength)
confirmedPivotLow = ta.pivotlow(low, pivotStrength, pivotStrength)
confirmedMinorHigh = ta.pivothigh(high, minorSwingStrength, minorSwingStrength)
confirmedMinorLow = ta.pivotlow(low, minorSwingStrength, minorSwingStrength)

var float resistanceCentre = na
var int resistanceReactions = 0
var int resistanceFirstBar = na
var int resistanceLastBar = na
var float supportCentre = na
var int supportReactions = 0
var int supportFirstBar = na
var int supportLastBar = na

// setupStage: 0 range search, 1 breakout, 2 extension, 3 qualified pullback.
var int setupStage = 0
var int setupDirection = 0
var float frozenResistance = na
var float frozenSupport = na
var float setupAtr = na
var float setupExtreme = na
var float frozenExtensionExtreme = na
var float pullbackExtreme = na
var bool pullbackStarted = false
var int breakoutBar = na
var int extensionBar = na
var int pullbackConfirmedBar = na
var int opposingCloseCount = 0
var float pullbackMinorSwing = na
var bool orderAwaitingFill = false
var bool activeImpulseSetup = false

var int pendingRiskTicks = na
var int pendingTargetTicks = na
var int entryOrderBar = na
var float tradeEntry = na
var float tradeStop = na
var float tradeTarget = na
var line activeTargetLine = na
var int observedClosedTrades = 0

bool longEntrySignal = false
bool shortEntrySignal = false
bool resetSetup = false
int setupResetReason = 0
float confirmedEntryDepth = na
int diagnosticReason = 0
activeMinimumRetracementAtr = activeImpulseSetup ? impulseMinimumRetracementAtr : minimumRetracementAtr
activeMaximumPullbackBars = activeImpulseSetup ? impulseMaximumPullbackBars : maximumPullbackBars

// Confirmed pivots remain observable during an active setup or trade. Breakout
// arming below still requires stage 0 and a flat strategy, so this only preserves
// information that was genuinely confirmed before a later opposite breakout.
canBuildRange = barstate.isconfirmed and not fxBlocked

if canBuildRange
    if not na(resistanceLastBar) and bar_index - resistanceLastBar > maximumRangeBars
        resistanceCentre := na
        resistanceReactions := 0
        resistanceFirstBar := na
        resistanceLastBar := na
    if not na(supportLastBar) and bar_index - supportLastBar > maximumRangeBars
        supportCentre := na
        supportReactions := 0
        supportFirstBar := na
        supportLastBar := na

    if not na(confirmedPivotHigh)
        pivotBar = bar_index - pivotStrength
        clusterTolerance = atrValue * clusterToleranceAtr
        joinsCluster = not na(resistanceCentre) and math.abs(confirmedPivotHigh - resistanceCentre) <= clusterTolerance and pivotBar - resistanceFirstBar <= maximumRangeBars
        if joinsCluster
            resistanceCentre := (resistanceCentre * resistanceReactions + confirmedPivotHigh) / (resistanceReactions + 1)
            resistanceReactions += 1
            resistanceLastBar := pivotBar
        else
            resistanceCentre := confirmedPivotHigh
            resistanceReactions := 1
            resistanceFirstBar := pivotBar
            resistanceLastBar := pivotBar

    if not na(confirmedPivotLow)
        pivotBar = bar_index - pivotStrength
        clusterTolerance = atrValue * clusterToleranceAtr
        joinsCluster = not na(supportCentre) and math.abs(confirmedPivotLow - supportCentre) <= clusterTolerance and pivotBar - supportFirstBar <= maximumRangeBars
        if joinsCluster
            supportCentre := (supportCentre * supportReactions + confirmedPivotLow) / (supportReactions + 1)
            supportReactions += 1
            supportLastBar := pivotBar
        else
            supportCentre := confirmedPivotLow
            supportReactions := 1
            supportFirstBar := pivotBar
            supportLastBar := pivotBar

rangeFirstReaction = math.min(nz(resistanceFirstBar, bar_index), nz(supportFirstBar, bar_index))
rangeLastReaction = math.max(nz(resistanceLastBar, bar_index), nz(supportLastBar, bar_index))
rangeDuration = rangeLastReaction - rangeFirstReaction
rangeHeight = resistanceCentre - supportCentre
rangeIsConfirmed = setupStage == 0 and resistanceReactions >= minimumReactions and supportReactions >= minimumReactions and not na(rangeHeight) and rangeHeight >= atrValue * minimumRangeHeightAtr and rangeDuration >= minimumRangeBars and rangeDuration <= maximumRangeBars

// -----------------------------------------------------------------------------
// RANGE -> BREAKOUT -> EXTENSION -> PULLBACK -> RESUMPTION
// -----------------------------------------------------------------------------
if barstate.isconfirmed and setupMode == "Range Breakout-Pullback" and rangeIsConfirmed and strategy.position_size == 0 and not orderAwaitingFill and na(pendingRiskTicks) and not fxBlocked
    longBodyPasses = minimumBreakoutBodyAtr == 0.0 or close - open >= atrValue * minimumBreakoutBodyAtr
    shortBodyPasses = minimumBreakoutBodyAtr == 0.0 or open - close >= atrValue * minimumBreakoutBodyAtr
    longBreakout = enableLongs and longBodyPasses and close > resistanceCentre + atrValue * breakoutBufferAtr
    shortBreakout = enableShorts and shortBodyPasses and close < supportCentre - atrValue * breakoutBufferAtr
    if longBreakout or shortBreakout
        setupDirection := longBreakout ? 1 : -1
        setupStage := 1
        frozenResistance := resistanceCentre
        frozenSupport := supportCentre
        setupAtr := atrValue
        setupExtreme := setupDirection == 1 ? high : low
        frozenExtensionExtreme := na
        pullbackExtreme := na
        pullbackStarted := false
        breakoutBar := bar_index
        extensionBar := na
        pullbackConfirmedBar := na
        opposingCloseCount := 0
        pullbackMinorSwing := na
        activeImpulseSetup := false
        resistanceCentre := na
        resistanceReactions := 0
        resistanceFirstBar := na
        resistanceLastBar := na
        supportCentre := na
        supportReactions := 0
        supportFirstBar := na
        supportLastBar := na

// Impulse mode deliberately bypasses horizontal-range qualification. A large
// directional closed candle arms the existing pullback/resumption machinery.
if barstate.isconfirmed and setupMode == "Impulse Pullback Continuation" and setupStage == 0 and strategy.position_size == 0 and not orderAwaitingFill and na(pendingRiskTicks) and not fxBlocked
    longImpulse = enableLongs and close > open and close - open >= atrValue * impulseMinimumBodyAtr and high - low >= atrValue * impulseMinimumRangeAtr
    shortImpulse = enableShorts and close < open and open - close >= atrValue * impulseMinimumBodyAtr and high - low >= atrValue * impulseMinimumRangeAtr
    if longImpulse or shortImpulse
        setupDirection := longImpulse ? 1 : -1
        setupStage := 2
        activeImpulseSetup := true
        frozenResistance := setupDirection == 1 ? open : na
        frozenSupport := setupDirection == -1 ? open : na
        setupAtr := atrValue
        setupExtreme := setupDirection == 1 ? high : low
        frozenExtensionExtreme := na
        pullbackExtreme := na
        pullbackStarted := false
        breakoutBar := bar_index
        extensionBar := bar_index
        pullbackConfirmedBar := na
        opposingCloseCount := 0
        pullbackMinorSwing := na

if barstate.isconfirmed and setupStage == 1 and bar_index > breakoutBar
    materiallyInvalid = setupDirection == 1 ? close < frozenResistance - setupAtr * invalidationToleranceAtr : close > frozenSupport + setupAtr * invalidationToleranceAtr
    extensionExpired = bar_index - breakoutBar > maximumExtensionBars
    if materiallyInvalid or extensionExpired
        resetSetup := true
        setupResetReason := materiallyInvalid ? 1 : 2
    else if setupDirection == 1
        setupExtreme := math.max(setupExtreme, high)
        if setupExtreme >= frozenResistance + setupAtr * minimumExtensionAtr
            setupStage := 2
            extensionBar := bar_index
            pullbackExtreme := na
    else
        setupExtreme := math.min(setupExtreme, low)
        if setupExtreme <= frozenSupport - setupAtr * minimumExtensionAtr
            setupStage := 2
            extensionBar := bar_index
            pullbackExtreme := na

if barstate.isconfirmed and setupStage == 2 and bar_index > extensionBar
    if setupDirection == 1
        if not pullbackStarted
            madeNewExtreme = high > setupExtreme
            setupExtreme := math.max(setupExtreme, high)
            if close < close[1]
                pullbackStarted := true
                frozenExtensionExtreme := setupExtreme
                pullbackExtreme := low
                opposingCloseCount := 1
                extensionBar := bar_index
            else if madeNewExtreme
                extensionBar := bar_index
        else
            pullbackExtreme := math.min(pullbackExtreme, low)
            opposingCloseCount += close < close[1] ? 1 : 0
        materiallyInvalid = close < frozenResistance - setupAtr * invalidationToleranceAtr
        expired = bar_index - extensionBar > activeMaximumPullbackBars
        extensionDistance = frozenExtensionExtreme - frozenResistance
        pullbackDepth = pullbackStarted and extensionDistance > 0.0 ? (frozenExtensionExtreme - pullbackExtreme) / extensionDistance * 100.0 : na
        retracementPasses = pullbackStarted and frozenExtensionExtreme - pullbackExtreme >= setupAtr * activeMinimumRetracementAtr
        correctiveMovementPasses = opposingCloseCount >= minimumOpposingCloses and retracementPasses and pullbackDepth > 0.0
        depthMinimumPasses = pullbackDepthMode == "Any valid depth" or pullbackDepth >= selectedDepthMinimum
        depthMaximumExceeded = activeImpulseSetup ? pullbackDepth > impulseMaximumDepth : depthHasMaximum and pullbackDepth > selectedDepthMaximum
        if materiallyInvalid or expired or depthMaximumExceeded
            resetSetup := true
            setupResetReason := materiallyInvalid ? 1 : expired ? 3 : 4
        else if correctiveMovementPasses and depthMinimumPasses
            setupStage := 3
            pullbackConfirmedBar := bar_index
    else
        if not pullbackStarted
            madeNewExtreme = low < setupExtreme
            setupExtreme := math.min(setupExtreme, low)
            if close > close[1]
                pullbackStarted := true
                frozenExtensionExtreme := setupExtreme
                pullbackExtreme := high
                opposingCloseCount := 1
                extensionBar := bar_index
            else if madeNewExtreme
                extensionBar := bar_index
        else
            pullbackExtreme := math.max(pullbackExtreme, high)
            opposingCloseCount += close > close[1] ? 1 : 0
        materiallyInvalid = close > frozenSupport + setupAtr * invalidationToleranceAtr
        expired = bar_index - extensionBar > activeMaximumPullbackBars
        extensionDistance = frozenSupport - frozenExtensionExtreme
        pullbackDepth = pullbackStarted and extensionDistance > 0.0 ? (pullbackExtreme - frozenExtensionExtreme) / extensionDistance * 100.0 : na
        retracementPasses = pullbackStarted and pullbackExtreme - frozenExtensionExtreme >= setupAtr * activeMinimumRetracementAtr
        correctiveMovementPasses = opposingCloseCount >= minimumOpposingCloses and retracementPasses and pullbackDepth > 0.0
        depthMinimumPasses = pullbackDepthMode == "Any valid depth" or pullbackDepth >= selectedDepthMinimum
        depthMaximumExceeded = activeImpulseSetup ? pullbackDepth > impulseMaximumDepth : depthHasMaximum and pullbackDepth > selectedDepthMaximum
        if materiallyInvalid or expired or depthMaximumExceeded
            resetSetup := true
            setupResetReason := materiallyInvalid ? 1 : expired ? 3 : 4
        else if correctiveMovementPasses and depthMinimumPasses
            setupStage := 3
            pullbackConfirmedBar := bar_index

if barstate.isconfirmed and setupStage == 3
    pullbackExtreme := setupDirection == 1 ? math.min(pullbackExtreme, low) : math.max(pullbackExtreme, high)
    if setupDirection == 1 and not na(confirmedMinorHigh) and bar_index - minorSwingStrength >= extensionBar
        pullbackMinorSwing := confirmedMinorHigh
    if setupDirection == -1 and not na(confirmedMinorLow) and bar_index - minorSwingStrength >= extensionBar
        pullbackMinorSwing := confirmedMinorLow

    materiallyInvalid = setupDirection == 1 ? close < frozenResistance - setupAtr * invalidationToleranceAtr : close > frozenSupport + setupAtr * invalidationToleranceAtr
    expired = bar_index - extensionBar > activeMaximumPullbackBars
    extensionDistance = setupDirection == 1 ? frozenExtensionExtreme - frozenResistance : frozenSupport - frozenExtensionExtreme
    pullbackDepth = setupDirection == 1 ? (frozenExtensionExtreme - pullbackExtreme) / extensionDistance * 100.0 : (pullbackExtreme - frozenExtensionExtreme) / extensionDistance * 100.0
    depthMaximumExceeded = activeImpulseSetup ? pullbackDepth > impulseMaximumDepth : depthHasMaximum and pullbackDepth > selectedDepthMaximum
    canResume = bar_index > pullbackConfirmedBar
    aggressiveResume = setupDirection == 1 ? close > close[1] : close < close[1]
    balancedResume = setupDirection == 1 ? close > open and close > high[1] : close < open and close < low[1]
    conservativeResume = setupDirection == 1 ? not na(pullbackMinorSwing) and close > pullbackMinorSwing : not na(pullbackMinorSwing) and close < pullbackMinorSwing
    resumptionConfirmed = canResume and (confirmationMode == "Aggressive" ? aggressiveResume : confirmationMode == "Balanced" ? balancedResume : conservativeResume)

    if materiallyInvalid or expired or depthMaximumExceeded
        resetSetup := true
        setupResetReason := materiallyInvalid ? 1 : expired ? 3 : 4
    else if resumptionConfirmed and riskDataReady and strategy.position_size == 0 and not orderAwaitingFill and not fxBlocked
        entryAtrSnapshot = atrValue
        entryMultiplierSnapshot = selectedAtrMultiplier
        stopDistance = entryAtrSnapshot * entryMultiplierSnapshot
        pendingRiskTicks := math.max(1, int(math.ceil(stopDistance / syminfo.mintick)))
        pendingTargetTicks := math.max(1, int(math.round(pendingRiskTicks * riskRewardMultiple)))
        entryOrderBar := bar_index
        confirmedEntryDepth := pullbackDepth
        orderAwaitingFill := true
        longEntrySignal := setupDirection == 1
        shortEntrySignal := setupDirection == -1
        if longEntrySignal
            strategy.entry("L", strategy.long, comment="LONG")
            strategy.exit("LX", from_entry="L", loss=pendingRiskTicks, profit=pendingTargetTicks, comment="EXIT")
        else
            strategy.entry("S", strategy.short, comment="SHORT")
            strategy.exit("SX", from_entry="S", loss=pendingRiskTicks, profit=pendingTargetTicks, comment="EXIT")
        setupStage := 0
        setupDirection := 0

if resetSetup
    setupStage := 0
    setupDirection := 0
    frozenResistance := na
    frozenSupport := na
    setupAtr := na
    setupExtreme := na
    frozenExtensionExtreme := na
    pullbackExtreme := na
    pullbackStarted := false
    breakoutBar := na
    extensionBar := na
    pullbackConfirmedBar := na
    opposingCloseCount := 0
    pullbackMinorSwing := na
    activeImpulseSetup := false

// -----------------------------------------------------------------------------
// FX WEEKEND ENFORCEMENT AND FROZEN TRADE RISK
// -----------------------------------------------------------------------------
if fxBlocked
    strategy.cancel_all()
    orderAwaitingFill := false
    if strategy.position_size != 0
        strategy.close_all(comment="FX FLAT", immediately=true)
    setupStage := 0
    setupDirection := 0
    frozenResistance := na
    frozenSupport := na
    setupAtr := na
    setupExtreme := na
    frozenExtensionExtreme := na
    pullbackExtreme := na
    pullbackStarted := false
    breakoutBar := na
    extensionBar := na
    pullbackConfirmedBar := na
    opposingCloseCount := 0
    pullbackMinorSwing := na
    activeImpulseSetup := false
    resistanceCentre := na
    resistanceReactions := 0
    resistanceFirstBar := na
    resistanceLastBar := na
    supportCentre := na
    supportReactions := 0
    supportFirstBar := na
    supportLastBar := na

// The relative-tick bracket was submitted with the entry signal, so protection
// does not depend on an extra fill-triggered calculation. The actual average fill
// is used only to reconstruct the frozen prices for chart display.
if orderAwaitingFill and not na(entryOrderBar) and bar_index > entryOrderBar
    orderAwaitingFill := false

if strategy.position_size != 0 and na(tradeStop)
    orderAwaitingFill := false
    tradeEntry := strategy.position_avg_price
    riskDistance = nz(pendingRiskTicks, 1) * syminfo.mintick
    targetDistance = nz(pendingTargetTicks, 1) * syminfo.mintick
    if strategy.position_size > 0
        tradeStop := roundDownToTick(tradeEntry - riskDistance)
        tradeTarget := roundUpToTick(tradeEntry + targetDistance)
    else
        tradeStop := roundUpToTick(tradeEntry + riskDistance)
        tradeTarget := roundDownToTick(tradeEntry - targetDistance)
    actualEntryBar = strategy.opentrades.entry_bar_index(0)
    activeTargetLine := line.new(actualEntryBar, tradeTarget, bar_index, tradeTarget, xloc=xloc.bar_index, extend=extend.none, color=color.teal, width=2)

if strategy.position_size != 0 and not na(activeTargetLine)
    line.set_x2(activeTargetLine, bar_index)

// Finish each target at the broker emulator's actual exit bar. If a trade opens
// and closes before this script observes an open position, closed-trade data still
// supplies its actual entry and exit bars without requiring calc_on_order_fills.
if strategy.closedtrades > observedClosedTrades
    lastClosedTrade = strategy.closedtrades - 1
    actualExitBar = strategy.closedtrades.exit_bar_index(lastClosedTrade)
    if not na(activeTargetLine)
        line.set_x2(activeTargetLine, actualExitBar)
    else if not na(pendingTargetTicks)
        actualEntryBar = strategy.closedtrades.entry_bar_index(lastClosedTrade)
        actualEntryPrice = strategy.closedtrades.entry_price(lastClosedTrade)
        wasLongTrade = strategy.closedtrades.size(lastClosedTrade) > 0
        targetDistance = pendingTargetTicks * syminfo.mintick
        closedTarget = wasLongTrade ? roundUpToTick(actualEntryPrice + targetDistance) : roundDownToTick(actualEntryPrice - targetDistance)
        line.new(actualEntryBar, closedTarget, actualExitBar, closedTarget, xloc=xloc.bar_index, extend=extend.none, color=color.teal, width=2)
    activeTargetLine := na
    observedClosedTrades := strategy.closedtrades

if strategy.position_size == 0 and not orderAwaitingFill and not na(pendingRiskTicks)
    tradeEntry := na
    tradeStop := na
    tradeTarget := na
    pendingRiskTicks := na
    pendingTargetTicks := na
    entryOrderBar := na
    frozenResistance := na
    frozenSupport := na
    setupAtr := na
    setupExtreme := na
    frozenExtensionExtreme := na
    pullbackExtreme := na
    pullbackStarted := false
    breakoutBar := na
    extensionBar := na
    pullbackConfirmedBar := na
    opposingCloseCount := 0
    pullbackMinorSwing := na
    activeImpulseSetup := false

// -----------------------------------------------------------------------------
// AUDIT VISUALS
// -----------------------------------------------------------------------------
showFrozenRange = setupStage != 0 or strategy.position_size != 0 or orderAwaitingFill
displayResistance = showFrozenRange ? frozenResistance : rangeIsConfirmed ? resistanceCentre : na
displaySupport = showFrozenRange ? frozenSupport : rangeIsConfirmed ? supportCentre : na
displayZoneHalfWidth = showFrozenRange ? setupAtr * clusterToleranceAtr : atrValue * clusterToleranceAtr

resistanceUpperPlot = plot(showSetupDiagnostics and not na(displayResistance) ? displayResistance + displayZoneHalfWidth : na, "Resistance zone upper", color=color.new(color.blue, 55), linewidth=1)
resistanceLowerPlot = plot(showSetupDiagnostics and not na(displayResistance) ? displayResistance - displayZoneHalfWidth : na, "Resistance zone lower", color=color.new(color.blue, 55), linewidth=1)
supportUpperPlot = plot(showSetupDiagnostics and not na(displaySupport) ? displaySupport + displayZoneHalfWidth : na, "Support zone upper", color=color.new(color.blue, 55), linewidth=1)
supportLowerPlot = plot(showSetupDiagnostics and not na(displaySupport) ? displaySupport - displayZoneHalfWidth : na, "Support zone lower", color=color.new(color.blue, 55), linewidth=1)
fill(resistanceUpperPlot, resistanceLowerPlot, color=color.new(color.blue, 88), title="Resistance zone")
fill(supportUpperPlot, supportLowerPlot, color=color.new(color.blue, 88), title="Support zone")

diagnosticCanResumeLong = setupStage == 3 and setupDirection == 1 and bar_index > pullbackConfirmedBar
diagnosticAggressiveLong = close > close[1]
diagnosticBalancedLong = close > open and close > high[1]
diagnosticConservativeLong = not na(pullbackMinorSwing) and close > pullbackMinorSwing
diagnosticLongResumption = diagnosticCanResumeLong and (confirmationMode == "Aggressive" ? diagnosticAggressiveLong : confirmationMode == "Balanced" ? diagnosticBalancedLong : diagnosticConservativeLong)
diagnosticCanResumeShort = setupStage == 3 and setupDirection == -1 and bar_index > pullbackConfirmedBar
diagnosticAggressiveShort = close < close[1]
diagnosticBalancedShort = close < open and close < low[1]
diagnosticConservativeShort = not na(pullbackMinorSwing) and close < pullbackMinorSwing
diagnosticShortResumption = diagnosticCanResumeShort and (confirmationMode == "Aggressive" ? diagnosticAggressiveShort : confirmationMode == "Balanced" ? diagnosticBalancedShort : diagnosticConservativeShort)
diagnosticResumption = setupDirection == 1 ? diagnosticLongResumption : setupDirection == -1 ? diagnosticShortResumption : false
diagnosticLongGate = longEntrySignal ? 12 : strategy.position_size > 0 ? 13 : not enableLongs ? 1 : fxBlocked ? 2 : strategy.position_size != 0 or orderAwaitingFill or not na(pendingRiskTicks) ? 3 : setupStage != 0 and setupDirection == -1 ? 4 : setupStage == 0 and not rangeIsConfirmed ? 5 : setupStage == 0 ? 6 : setupStage == 1 ? 7 : setupStage == 2 and not pullbackStarted ? 8 : setupStage == 2 ? 9 : not diagnosticLongResumption ? 10 : not riskDataReady ? 11 : 12
diagnosticReason := fxBlocked ? 1 : strategy.position_size != 0 or orderAwaitingFill ? 2 : setupMode == "Range Breakout-Pullback" and setupStage == 0 and not rangeIsConfirmed ? 3 : setupMode == "Impulse Pullback Continuation" and setupStage == 0 ? 4 : setupStage == 1 ? 5 : setupStage == 2 and not pullbackStarted ? 6 : setupStage == 2 ? 7 : setupStage == 3 and not diagnosticResumption ? 8 : setupStage == 3 and not riskDataReady ? 9 : longEntrySignal or shortEntrySignal ? 10 : 0
diagnosticExtensionDistance = setupDirection == 1 ? frozenExtensionExtreme - frozenResistance : frozenSupport - frozenExtensionExtreme
diagnosticDepth = longEntrySignal or shortEntrySignal ? confirmedEntryDepth : setupStage >= 2 and pullbackStarted and diagnosticExtensionDistance > 0.0 ? (setupDirection == 1 ? frozenExtensionExtreme - pullbackExtreme : pullbackExtreme - frozenExtensionExtreme) / diagnosticExtensionDistance * 100.0 : na

// Diagnostics stay in the Data Window instead of adding candle annotations.
plot(showSetupDiagnostics ? setupStage : na, "Diagnostic: setup stage", display=display.data_window)
plot(showSetupDiagnostics ? setupDirection : na, "Diagnostic: setup direction", display=display.data_window)
plot(showSetupDiagnostics ? diagnosticLongGate : na, "Diagnostic: bullish gate", display=display.data_window)
plot(showSetupDiagnostics ? setupResetReason : na, "Diagnostic: reset reason", display=display.data_window)
plot(showSetupDiagnostics ? (rangeIsConfirmed ? 1 : 0) : na, "Diagnostic: range ready", display=display.data_window)
plot(showSetupDiagnostics ? (riskDataReady ? 1 : 0) : na, "Diagnostic: ATR ready", display=display.data_window)
plot(showSetupDiagnostics ? (fxBlocked ? 1 : 0) : na, "Diagnostic: FX blocked", display=display.data_window)
plot(showSetupDiagnostics ? (longEntrySignal ? 1 : shortEntrySignal ? -1 : 0) : na, "Diagnostic: entry requested", display=display.data_window)
plot(showSetupDiagnostics ? diagnosticDepth : na, "Diagnostic: pullback depth (%)", display=display.data_window)
plot(showSetupDiagnostics ? diagnosticReason : na, "Diagnostic: gate (1 FX,2 busy,3 range,4 impulse,5 extension,6 pullback,7 correction/depth,8 confirmation,9 ATR,10 entry)", display=display.data_window)

plot(showStopLoss and strategy.position_size != 0 ? tradeStop : na, "Frozen stop-loss", color=color.red, linewidth=2, style=plot.style_linebr)

bgcolor(shadeWeekendBlackout and fxBlocked ? color.new(color.gray, 86) : na, title="FX Weekend blackout")

// Broker-emulator note: if a stop and target are both reachable inside one
// historical candle, the assumed fill depends on TradingView's intrabar model,
// available lower-timeframe data, Bar Magnifier setting, commission and slippage.
